        <!-- Grid status icons (colored) -->
        <file>icons/check-green.svg</file>
        <file>icons/alert-yellow.svg</file>
        <file>icons/alert-red.svg</file>
        <file>icons/alert-triangle.svg</file>
        <!-- Profile icons (colored) -->
        <file>icons/profile-game.svg</file>
        <file>icons/profile-sword.svg</file>
        <file>icons/profile-shield.svg</file>
        <file>icons/profile-star.svg</file>
        <file>icons/profile-layers.svg</file>
        <file>icons/profile-sun.svg</file>
        <file>icons/profile-moon.svg</file>
        <file>icons/profile-alert.svg</file>
        <file>icons/profile-user.svg</file>
        <file>icons/profile-clock.svg</file>
        <file>icons/profile-zap.svg</file>
        <file>icons/profile-heart.svg</file>
        <file>icons/profile-target.svg</file>
        <file>icons/profile-compass.svg</file>
        <file>icons/profile-hexagon.svg</file>
        <file>icons/profile-infinity.svg</file>
        <file>icons/profile-music.svg</file>
        <file>icons/profile-crescent.svg</file>
        <file>icons/profile-flame.svg</file>
        <file>icons/profile-stack.svg</file>
        <!-- Additional UI icons (gold) -->
        <file>icons/save.svg</file>
        <file>icons/book.svg</file>
        <file>icons/lightbulb.svg</file>
        <file>icons/external-link.svg</file>
        <file>icons/x.svg</file>
        <file>icons/minus.svg</file>
        <file>icons/minus-gold.svg</file>
        <file>icons/upload.svg</file>
        <file>icons/layout.svg</file>
        <file>icons/lock.svg</file>
        <file>icons/monitor.svg</file>
        <file>icons/terminal.svg</file>
        <file>icons/keyboard.svg</file>
        <file>icons/tool.svg</file>
        <!-- Status icons (colored) -->
        <file>icons/check-circle.svg</file>
        <file>icons/x-circle.svg</file>
        <file>icons/wifi.svg</file>
        <file>icons/wifi-off.svg</file>
        <file>icons/refresh-dark.svg</file>
        <!-- Ping status circles -->
        <file>icons/circle-green.svg</file>
        <file>icons/circle-yellow.svg</file>
        <file>icons/circle-red.svg</file>
        <file>icons/circle-gray.svg</file>
        <!-- Spinbox arrows -->
        <file>icons/spin-up.svg</file>
        <file>icons/spin-down.svg</file>
