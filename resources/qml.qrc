<RCC>
    <qresource prefix="/">
        <file>qml/main.qml</file>
        <file>qml/components/GW2Button.qml</file>
        <file>qml/components/GW2Card.qml</file>
        <file>qml/components/GW2Toggle.qml</file>
        <!-- Navigation icons -->
        <file>icons/home.svg</file>
        <file>icons/box.svg</file>
        <file>icons/play.svg</file>
        <file>icons/grid.svg</file>
        <file>icons/play-circle.svg</file>
        <file>icons/settings.svg</file>
        <file>icons/globe.svg</file>
        <file>icons/palette.svg</file>
        <file>icons/map-pin.svg</file>
        <file>icons/compass.svg</file>
        <!-- Action icons -->
        <file>icons/refresh.svg</file>
